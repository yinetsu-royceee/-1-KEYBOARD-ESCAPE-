    label.Size = UDim2.new(1, -20, 0, 20)
    label.Position = UDim2.new(0, 15, 0, 8)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamMedium
    label.Text = labelText .. ": " .. default .. (suffix and " " .. suffix or "")
    label.TextColor3 = Color3.fromRGB(230,230,240)
    label.TextSize = FONT_SIZE
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -30, 0, IS_MOBILE and 14 or 8)
    track.Position = UDim2.new(0, 15, 1, IS_MOBILE and -28 or -20)
    track.BackgroundColor3 = Color3.fromRGB(40,40,55)
    track.BorderSizePixel = 0
    track.Parent = row
    createCorner(track, 7)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
    fill.BackgroundColor3 = rgbColor(0)
    fill.BorderSizePixel = 0
    fill.Parent = track
    createCorner(fill, 7)
    local knobSz = IS_MOBILE and 24 or 16
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, knobSz, 0, knobSz)
    knob.Position = UDim2.new((default - min)/(max - min), -knobSz/2, 0.5, -knobSz/2)
    knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
    knob.BorderSizePixel = 0
    knob.Parent = track
    createCorner(knob, knobSz/2)
    local dragging = false
    local value = default
    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel)
        tween(fill, EASE.FAST, {Size = UDim2.new(rel, 0, 1, 0)})
        tween(knob, EASE.FAST, {Position = UDim2.new(rel, -knobSz/2, 0.5, -knobSz/2)})
        label.Text = labelText .. ": " .. value .. (suffix and " " .. suffix or "")
        if callback then callback(value) end
    end
    local hitbox = Instance.new("TextButton")
    hitbox.Size = UDim2.new(1, 0, 0, IS_MOBILE and 50 or 20)
    hitbox.Position = UDim2.new(0, 0, 0.5, IS_MOBILE and -5 or 0)
    hitbox.BackgroundTransparency = 1
    hitbox.Text = ""
    hitbox.Parent = track
    hitbox.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(i.Position.X)
        end
    end)
    hitbox.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(i.Position.X)
        end
    end)
    task.spawn(function()
        while row.Parent do fill.BackgroundColor3 = rgbColor(0) RunService.RenderStepped:Wait() end
    end)
    return row
end

