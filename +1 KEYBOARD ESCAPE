                Title = "YINETSU HUB",
                Text = "+1 Speed! Total bonus: " .. currentSpeedBonus .. " (WalkSpeed: " .. (baseSpeed + currentSpeedBonus) .. ")",
                Duration = 2,
            })
        end
    end
end)

