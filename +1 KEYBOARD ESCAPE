local speedBoostActive = true
local baseSpeed = 16
local currentSpeedBonus = 0

local function addSpeed()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        currentSpeedBonus = currentSpeedBonus + 1
        hum.WalkSpeed = baseSpeed + currentSpeedBonus
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "YINETSU HUB",
                Text = "+1 Speed! Bonus: " .. currentSpeedBonus .. " | WalkSpeed: " .. (baseSpeed + currentSpeedBonus),
                Duration = 1.5,
            })
        end)
    end
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.E and speedBoostActive then addSpeed() end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1)
    currentSpeedBonus = 0
end)

