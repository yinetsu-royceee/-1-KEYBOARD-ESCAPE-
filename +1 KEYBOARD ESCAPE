speedStroke.Thickness = 2
speedStroke.Color = Color3.fromRGB(255, 100, 255)
speedStroke.Parent = speedBtn

local baseSpeed = 16
local bonus = 0

local function addSpeed()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        bonus = bonus + 1
        hum.WalkSpeed = baseSpeed + bonus
        speedBtn.Text = "+1 SPEED  ⚡   Bonus: +" .. bonus
    end
end

speedBtn.MouseButton1Click:Connect(addSpeed)

