-- LOADING STEPS
local steps = {
    {text = "Loading modules...", progress = 0.25},
    {text = "Fetching avatar...", progress = 0.5},
    {text = "Bypassing anti-cheat...", progress = 0.75},
    {text = "Welcome, " .. LocalPlayer.DisplayName .. "!", progress = 1},
}

for _, step in ipairs(steps) do
    status.Text = step.text
    TweenService:Create(barFill, TweenInfo.new(0.45, Enum.EasingStyle.Quint), {
        Size = UDim2.new(step.progress, 0, 1, 0)
    }):Play()
    task.wait(0.5)
end

task.wait(0.4)

-- FADE OUT box
TweenService:Create(dim, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
TweenService:Create(box, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
TweenService:Create(boxStroke, TweenInfo.new(0.5), {Transparency = 1}):Play()
for _, v in ipairs(box:GetDescendants()) do
    if v:IsA("TextLabel") or v:IsA("ImageLabel") then
        TweenService:Create(v, TweenInfo.new(0.5), {TextTransparency = 1, ImageTransparency = 1}):Play()
    elseif v:IsA("Frame") then
        TweenService:Create(v, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    elseif v:IsA("UIStroke") then
        TweenService:Create(v, TweenInfo.new(0.5), {Transparency = 1}):Play()
    end
end
task.wait(0.6)
