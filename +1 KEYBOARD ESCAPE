local base = 16
local bn = 0

local function addspeed()
    local c = LocalPlayer.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then
        bn = bn + 1
        h.WalkSpeed = base + bn
        sbtn.Text = "+1 SPEED  ⚡   Bonus: +" .. bn
    end
end

sbtn.MouseButton1Click:Connect(addspeed)

